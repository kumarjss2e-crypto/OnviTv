{
  "expo": {
    "name": "OnviTV",
    "slug": "onvitv-app",
    "version": "1.6.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/AppIcon@3x.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e1b4b"
    },
    "updates": {
      "enabled": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onvitv.com",
      "buildNumber": "1.6.1",
      "requireFullScreen": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/AppIcon@3x.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsInWebContent": true,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true,
              "NSTemporaryExceptionRequiresForwardSecrecy": false
            },
            "tx-4kott.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true,
              "NSTemporaryExceptionRequiresForwardSecrecy": false
            },
            "picons.cmshulk.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true,
              "NSTemporaryExceptionRequiresForwardSecrecy": false
            },
            "cmshulk.com": {
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true,
              "NSTemporaryExceptionRequiresForwardSecrecy": false
            }
          }
        },
        "NSCameraUsageDescription": "This app uses the camera to scan QR codes for playlist import.",
        "NSMicrophoneUsageDescription": "This app requires microphone access for video playback.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library for saving and loading playlists.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.1035586796015-3e7fqts0ftqo7uppq4nchpu7vfl8pasp"
            ]
          }
        ]
      },
      "usesIcloudStorage": false,
      "bitcode": false,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "associatedDomains": [
        "webcredentials:firebase.google.com"
      ]
    },
    "android": {
      "package": "com.onvitv.com",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcon@3x.png",
        "backgroundColor": "#1e1b4b"
      },
      "icon": "./assets/AppIcon@3x.png",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "13.4",
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 21,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34
          }
        }
      ],
      "expo-font"
    ],
    "notification": {
      "color": "#7C3AED",
      "androidMode": "default",
      "androidCollapsedTitle": "OnviTV"
    },
    "owner": "org9",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "1b5857ac-dbe8-4e3c-b2a8-c445d4ff2589"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-8363023387578083~2084137233",
    "ios_app_id": "ca-app-pub-8363023387578083~4485394709"
  }
}
